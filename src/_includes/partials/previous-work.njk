<section id="previouswork" class="tw:mx-auto tw:max-w-7xl tw:border-t tw:border-neutral-200 tw:px-4 tw:py-14 md:tw:px-6 md:tw:py-20">
  <div class="tw:mb-7 tw:flex tw:items-end tw:justify-between tw:gap-4 md:tw:mb-9">
    <h2 class="tw:font-sans tw:text-[14px] tw:font-bold tw:tracking-normal tw:text-black md:tw:text-[15px]">Archive</h2>
    <span class="tw:text-[14px] tw:font-normal tw:uppercase tw:tracking-[0.14em] tw:text-black">Selected work</span>
  </div>

  <div class="portfolio-grid">
    {% for previous in collections.previousWorks %}
    <article class="tw:flex tw:flex-col">
      <a href="{{ previous.url }}" class="tw:block tw:overflow-hidden tw:rounded-2xl tw:border tw:border-neutral-200 tw:bg-neutral-50">
        {% if previous.data.img %}
        <img src="/assets/img/portfolio/{{ previous.data.img }}" class="tw:aspect-[4/3] tw:w-full tw:object-cover tw:transition hover:tw:scale-[1.01]" alt="{{ previous.data.alt or previous.data.title }}">
        {% endif %}
      </a>
      <h3 class="tw:mt-5 tw:font-sans tw:text-[18px] tw:font-bold tw:leading-snug tw:tracking-[-0.02em] tw:text-black md:tw:text-[20px]">
        <a href="{{ previous.url }}" class="tw:transition hover:tw:opacity-70">
          {{- previous.data.title -}}
          {%- if previous.data['project-date'] %} {{ previous.data['project-date'] }}{% endif -%}
          {%- if previous.data.category %} {{ previous.data.category }}{% endif -%}
        </a>
      </h3>
      {% if previous.data.description %}
      <p class="tw:mt-3 tw:text-[14px] tw:font-normal tw:leading-relaxed tw:text-black">{{ previous.data.description }}</p>
      {% endif %}
      <a href="{{ previous.url }}" class="tw:mt-4 tw:inline-flex tw:items-center tw:gap-1 tw:self-start tw:text-[14px] tw:font-normal tw:text-black tw:transition hover:tw:opacity-70">
        Project<span aria-hidden="true">→</span>
      </a>
    </article>
    {% endfor %}
  </div>
</section>
