<header class="tw:bg-white">
  <div class="tw:mx-auto tw:flex tw:max-w-7xl tw:items-start tw:justify-between tw:gap-8 tw:px-4 tw:py-5 md:tw:px-6 md:tw:py-6">
    <div class="tw:min-w-0">
      <p class="tw:font-sans tw:text-[14px] tw:font-bold tw:leading-tight tw:tracking-tight tw:text-black">{{ site.title }}</p>
      <p class="tw:mt-3 tw:text-[14px] tw:font-normal tw:leading-snug tw:text-black md:tw:mt-4">{{ site.role }}</p>
      <p class="tw:mt-1 tw:text-[14px] tw:font-normal tw:text-black">© {{ buildYear }}</p>
    </div>
    <div class="tw:flex tw:shrink-0 tw:items-start tw:pt-0.5">
      {% for network in site.social %}
        {% if network.title == "linkedin" %}
        <a href="{{ network.url }}" class="tw:inline-flex tw:shrink-0 tw:text-black tw:transition hover:tw:opacity-70" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          {# Framer-style 18×18 LinkedIn mark (matches koenjansen.com-style asset) #}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" width="18" height="18" class="tw:block tw:h-[18px] tw:w-[18px] tw:shrink-0 tw:[image-rendering:pixelated]" fill="currentColor" aria-hidden="true" focusable="false">
            <g transform="translate(0.5 0)">
              <path d="M 3.918 17.5 L 0.289 17.5 L 0.289 5.816 L 3.918 5.816 Z M 2.102 4.223 C 0.941 4.223 0 3.262 0 2.102 C 0 1.544 0.221 1.01 0.615 0.616 C 1.01 0.221 1.544 0 2.102 0 C 2.659 0 3.194 0.221 3.588 0.616 C 3.982 1.01 4.203 1.544 4.203 2.102 C 4.203 3.262 3.262 4.223 2.102 4.223 Z M 17.496 17.5 L 13.875 17.5 L 13.875 11.812 C 13.875 10.457 13.848 8.719 11.988 8.719 C 10.102 8.719 9.813 10.191 9.813 11.715 L 9.813 17.5 L 6.188 17.5 L 6.188 5.816 L 9.668 5.816 L 9.668 7.41 L 9.719 7.41 C 10.203 6.492 11.387 5.523 13.152 5.523 C 16.824 5.523 17.5 7.941 17.5 11.082 L 17.5 17.5 Z" fill="currentColor"/>
            </g>
          </svg>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</header>
